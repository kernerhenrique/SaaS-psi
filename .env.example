# Postgres local via docker-compose (docker compose up -d) — porta 5433
DATABASE_URL="postgresql://psi:psi@localhost:5433/psi?schema=public"

# Gere um valor próprio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-um-valor-aleatorio-de-32-bytes-em-hexadecimal"

# Chave para criptografar os campos do prontuário (32 bytes em hexadecimal, gere como acima).
# Nunca troque depois de ter dados salvos: os prontuários antigos ficariam ilegíveis.
RECORDS_ENCRYPTION_KEY="troque-por-um-valor-aleatorio-de-32-bytes-em-hexadecimal"

# Claude API (organiza o ditado nos campos do prontuário) — console.anthropic.com
ANTHROPIC_API_KEY=""

APP_BASE_URL="http://localhost:3001"
