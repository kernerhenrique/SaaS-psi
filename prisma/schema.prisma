generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Convenções:
// - Toda tabela de dados da psicóloga tem `businessId` e toda query filtra por ele.
// - Campos marcados "criptografado" guardam texto cifrado (AES-256-GCM, ver
//   src/server/crypto/records-cipher.ts): prontuário é dado sensível de saúde.
// - Prontuário nunca é apagado de verdade (`deletedAt`): o CFP exige guarda
//   mínima de 5 anos.

enum UserRole {
  OWNER
}

enum SessionStatus {
  SCHEDULED
  DONE
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  WONT_PAY
}

enum PaymentMethod {
  PIX
  CASH
  CARD
  TRANSFER
}

enum NoteStatus {
  DRAFT
  FINAL
}

enum MessageTemplateKind {
  REMINDER
  RETURN_INVITE
  PAYMENT_REMINDER
}

/// Uma psicóloga (ou consultório) cliente do sistema.
model Business {
  id                  String    @id @default(cuid())
  name                String
  timezone            String    @default("America/Sao_Paulo")
  crp                 String?
  whatsapp            String?
  address             String?
  logoUrl             String?
  /// Cor de destaque da marca; null usa o padrão do produto.
  accentColor         String?
  /// Após quantos dias de pagamento pendente o sistema sugere a mensagem de cobrança.
  paymentReminderDays Int       @default(3)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  users            User[]
  sessionTypes     SessionType[]
  patients         Patient[]
  guardians        Guardian[]
  sessions         Session[]
  parentNotes      ParentIntakeNote[]
  sessionNotes     SessionNote[]
  followUps        FollowUpItem[]
  sessionReports   SessionReport[]
  messageTemplates MessageTemplate[]

  @@index([deletedAt])
}

model User {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(OWNER)
  // Incrementado em logout/troca de senha para invalidar de uma vez todos os
  // refresh tokens já emitidos, sem precisar de uma tabela de sessões.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId])
}

/// Tipo de consulta (Primeira consulta, Retorno) com o valor padrão.
model SessionType {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  priceCents   Int
  durationMin  Int      @default(50)
  isFirstVisit Boolean  @default(false)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]

  @@index([businessId])
}

/// Dados fixos do paciente (preenchidos uma vez, editáveis depois).
model Patient {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fullName   String
  birthDate  DateTime? @db.Date
  /// Informações importantes de saúde (criptografado).
  healthInfo String?
  /// Observações gerais (criptografado).
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  guardians   Guardian[]
  sessions    Session[]
  parentNotes ParentIntakeNote[]
  followUps   FollowUpItem[]

  @@index([businessId, fullName])
}

/// Pai, mãe ou outro responsável — com quem a psicóloga conversa pelo WhatsApp.
model Guardian {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name         String
  /// Ex.: Mãe, Pai, Avó.
  relationship String
  phone        String?
  email        String?
  /// Responsável que recebe as mensagens por padrão.
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId])
  @@index([patientId])
}

/// Uma consulta na agenda, com o controle de pagamento (feito fora da plataforma).
model Session {
  id            String         @id @default(cuid())
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  sessionTypeId String
  sessionType   SessionType    @relation(fields: [sessionTypeId], references: [id], onDelete: Restrict)
  startAt       DateTime       @db.Timestamptz(6)
  endAt         DateTime       @db.Timestamptz(6)
  status        SessionStatus  @default(SCHEDULED)
  /// Pré-preenchido pelo tipo de consulta; editável (desconto, negociação).
  amountCents   Int
  paymentStatus PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?
  /// Dia em que o pagamento foi recebido (pode ser diferente do dia da consulta).
  paidAt        DateTime?      @db.Date
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  note      SessionNote?
  report    SessionReport?
  followUps FollowUpItem[]

  @@index([businessId, startAt])
  @@index([businessId, status, paymentStatus])
  @@index([patientId, startAt])
}

/// Anotações do contato com os pais/responsáveis (normalmente antes da primeira consulta).
model ParentIntakeNote {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patientId  String
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  date       DateTime  @db.Date
  /// Criptografado.
  content    String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([businessId])
  @@index([patientId, date])
}

/// Anotações de uma consulta: relato dos pais + sessão com o paciente.
/// Primeira consulta ou retorno é definido pelo tipo da sessão.
model SessionNote {
  id             String     @id @default(cuid())
  businessId     String
  business       Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessionId      String     @unique
  session        Session    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  /// Resumo do que os pais/responsáveis relataram (criptografado).
  parentReport   String?
  /// Resumo da sessão com o paciente (criptografado).
  patientSession String?
  /// Rascunho (ex.: gerado pelo ditado + IA) até a psicóloga revisar e salvar.
  status         NoteStatus @default(DRAFT)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  @@index([businessId])
}

/// Destaque para acompanhar na próxima sessão (ex.: "verificar se melhorou o sono").
model FollowUpItem {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  sourceSessionId String?
  sourceSession   Session?  @relation(fields: [sourceSessionId], references: [id], onDelete: SetNull)
  /// Criptografado.
  text            String
  doneAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([businessId])
  @@index([patientId, doneAt])
}

/// Relatório pós-consulta, gerado a partir da nota e editado pela psicóloga.
model SessionReport {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessionId  String    @unique
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  /// Criptografado.
  content    String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([businessId])
}

/// Modelo de mensagem de WhatsApp editável por cada psicóloga.
model MessageTemplate {
  id         String              @id @default(cuid())
  businessId String
  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       MessageTemplateKind
  content    String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([businessId, kind])
}
